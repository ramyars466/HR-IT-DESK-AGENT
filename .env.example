# ==========================================
# Enterprise HR/IT Helpdesk Agent Configuration
# ==========================================

# 1. Google Gemini LLM Credentials
# Get your API key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Database Configuration
# Connect to PostgreSQL instance (e.g. Docker, Supabase, local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_it_db
# If PostgreSQL is not active, the system automatically uses sqlite:///./data/hr_it_helpdesk.db

# 3. Model Context Protocol (MCP) Server
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
MCP_TRANSPORT=stdio

# 4. FastAPI Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# 5. Guardrails Configuration
ENABLE_PII_REDACTION=true
ENABLE_PROMPT_INJECTION_CHECK=true
ENABLE_TOPIC_RESTRICTION=true
